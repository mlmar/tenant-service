PORT=8080
CORS_ORIGINS=http://localhost:8081
CLERK_AUTHORIZED_PARTIES=http://localhost:8081
# Server credentials remain empty until dedicated services are provisioned.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DATABASE_URL=
DATABASE_SCHEMA=tenant_service_dev
SUPABASE_URL=
SUPABASE_STORAGE_SECRET=
SUPABASE_AVATAR_BUCKET=tenant-service-dev-avatars
# Group email: dedicated Postmark server, never an account-management token.
EMAIL_ENABLED=false
POSTMARK_SERVER_TOKEN=
POSTMARK_DELIVERY_TYPE=Sandbox
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_FROM_EMAIL=
EMAIL_REPLY_TO=
# One-off email: dedicated Microsoft 365 OAuth application and mailbox grants.
SMTP_ENABLED=false
SMTP_USER=
SMTP_FROM=
MICROSOFT_365_TENANT_ID=
MICROSOFT_365_CLIENT_ID=
MICROSOFT_365_CLIENT_SECRET=
