{
  "name": "@tenant-service/frontend",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "build": "npm run icons && node scripts/generate-theme.mjs && expo export --platform web && node scripts/prepare-pwa.mjs",
    "icons": "node scripts/generate-app-icons.mjs",
    "dev": "expo start --web --host lan --port $PORT --clear",
    "prestart": "npm run icons",
    "preweb": "npm run icons",
    "predev": "npm run icons"
  },
  "dependencies": {
    "@clerk/expo": "^4.14.4",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native": "0.81.5",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
